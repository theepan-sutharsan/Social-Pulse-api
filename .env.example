# Social Pulse API — Environment Variables

# --- Database ---
DB_USER=root
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=3306
DB_NAME=social_pulse

# --- JWT ---
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# --- Flask ---
FLASK_DEBUG=1
FLASK_ENV=development
# Comma-separated Vercel origin(s) in production, or * for local development
CORS_ORIGINS=*

# --- Password reset ---
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TOKEN_MAX_AGE=3600
# Leave MAIL_SERVER empty for local development; the API logs a development reset link.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@socialpulse.local
MAIL_USE_TLS=1
MAIL_USE_SSL=0

# --- YouTube Data API v3 ---
YOUTUBE_API_KEY=your-youtube-api-key

# --- Meta (Facebook / Instagram) ---
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:5000/api/accounts/oauth-callback

# --- TikTok ---
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=http://localhost:5000/api/accounts/oauth-callback

# --- Claude (Anthropic) ---
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Google Gemini (AI Studio) — REST generateContent ---
GOOGLE_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-flash-latest

# --- Audio transcription ---
# The small model improves Tamil accuracy over tiny while remaining practical on CPU.
# Use medium for higher quality if the deployment has enough RAM/CPU.
WHISPER_MODEL=small

# --- Encryption (for stored OAuth tokens) ---
ENCRYPTION_KEY=your-32-byte-base64-encoded-fernet-key
